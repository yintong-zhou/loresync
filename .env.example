# --- Supabase (client, esposte al browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Supabase (solo lato server: MAI esporre al client) ---
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Estrazione metadata dal link ---
# User-Agent usato dal fetcher server-side per recuperare i tag OpenGraph
METADATA_FETCH_USER_AGENT=LoresyncBot/0.1 (+https://loresync.local)
# Timeout in millisecondi per il fetch della pagina sorgente
METADATA_FETCH_TIMEOUT_MS=8000

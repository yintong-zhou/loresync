# Copiare in `.env.local` (ignorato da git) e riempire con i valori del progetto.
# Next.js legge le variabili da questa cartella, non dalla root del repo.

# --- Supabase (esposte al browser) ---
# La publishable key e' pensata per essere pubblica: l'accesso ai dati e'
# governato dalle policy RLS definite in supabase/migrations/.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# --- Supabase (solo lato server) ---
# Bypassa completamente la RLS. Non serve all'app: aggiungerla solo se una
# utility batch in execution/ ne avra' davvero bisogno.
# SUPABASE_SECRET_KEY=sb_secret_<...>

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Estrazione metadata dal link (directives/extract_manga_metadata.md) ---
METADATA_FETCH_USER_AGENT=LoresyncBot/0.1 (+https://loresync.local)
METADATA_FETCH_TIMEOUT_MS=8000
